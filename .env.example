# Copy with `shortflow init`. It creates a random dashboard password with mode 0600.
CHANNEL_NAME=하루의 이득
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
SCHEDULE_ENABLED=true
DAILY_PREPARE_HOUR=8
UPLOAD_PLATFORMS=youtube,tiktok,instagram,naver
# Optional paths: DATA_DIR, SOURCES_FILE, FONT_PATH

# Create a Telegram bot with @BotFather. Start a private chat with that bot.
# Never send credentials to a chat or commit .env. Use secure environment settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google OAuth: upload + readonly scopes. Default is PRIVATE, not public.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_MADE_FOR_KIDS=false

# Direct Post may be unavailable for a personal/internal-only app.
# Personal/team-only internal upload utilities are not an accepted Direct Post use.
# manual is the supported default. approved_app is for a separately approved integration.
TIKTOK_PUBLISHING_MODE=manual
TIKTOK_ACCESS_TOKEN=
TIKTOK_APP_APPROVED=false
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Instagram Login: professional account & content publishing permission.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v23.0
# HTTPS origin serving this app to Meta; no trailing /public or auth.
PUBLIC_MEDIA_BASE_URL=
# Long random key used to sign public video URLs. Never reuse a platform token.
MEDIA_SIGNING_KEY=

# Optional paid AI. OFF by default. LLM_API_KEY is an OpenAI API credential.
# Both draft generation and TTS have per-request text limits, not a monthly billing cap.
LLM_ENABLED=false
TTS_ENABLED=false
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
